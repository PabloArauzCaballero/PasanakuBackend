{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    // Sin `rootDir`: a diferencia de `dominio-cliente`, este package importa
    // `@aportaya/ui/*` por alias (`tsconfig.base.json`) hacia `packages/ui/src/`, que
    // queda FUERA de cualquier `rootDir` fijado a `.`. Con `noEmit: true` (heredado
    // de la base) `rootDir` no cumple ningún rol para un typecheck puro -- solo
    // ordena la salida de un build que acá no existe.
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
