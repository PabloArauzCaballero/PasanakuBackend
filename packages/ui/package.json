{
  "name": "@aportaya/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema de diseño web de AportaYa: biblioteca Angular que consumen el backoffice y el sitio. Una entrada por componente (@aportaya/ui/<componente>), sin barril. Los tokens vienen generados de @aportaya/tokens.",
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "build": "echo 'ui: se consume por alias de tsconfig; `ng build` empaqueta con ng-packagr cuando haga falta publicar'",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "ng lint && python3 ../../scripts/verificar_frontend.py ui",
    "test:front": "ng test --include='src/**/*.spec.ts' --exclude='src/**/*.a11y.spec.ts'",
    "test:a11y": "ng test --include='src/**/*.a11y.spec.ts'",
    "empaquetar": "ng build"
  },
  "peerDependencies": {
    "@angular/common": "^22.2.1",
    "@angular/core": "^22.2.1"
  },
  "dependencies": {
    "@aportaya/tokens": "workspace:*",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@aportaya/simulado": "workspace:*",
    "@types/qrcode": "^1.5.5",
    "angular-eslint": "^22.5.0",
    "axe-core": "^4.10.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "ng-packagr": "^22.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  }
}
