# syntax=docker/dockerfile:1.7
#
# La app móvil compilada para la web, para probarla desde un navegador sin instalar
# un APK ni pasar por TestFlight.
#
#   docker build -f apps/movil/docker/Dockerfile.movil-web -t aportaya/movil-web .
#
# Necesita `clientes/dart/` generado antes (no está versionado, ADR-016), igual que los
# fronts Angular necesitan `clientes/angular/`.

# ------------------------------------------------------------------- tokens ---
# Los tokens de diseño se generan con Node puro (sin dependencias): no hace falta el
# `yarn install` de todo el monorepo para un archivo Dart.
FROM node:22-alpine AS tokens
WORKDIR /construccion
COPY packages/tokens/tokens.json packages/tokens/tokens.json
COPY packages/tokens/scripts packages/tokens/scripts
RUN node packages/tokens/scripts/a-dart.mjs

# ------------------------------------------------------------------ flutter ---
# Flutter clonado en el tag EXACTO del proyecto (3.44.8, ver planes y ADR-044). No hay
# imagen publicada de esa versión, y `stable` se mueve: el día que cambie, la app
# compilaría con otro Flutter del que se probó.
FROM debian:trixie-slim AS construccion
ARG FLUTTER_VERSION=3.44.8
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl unzip xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${FLUTTER_VERSION} https://github.com/flutter/flutter.git /flutter
ENV PATH="/flutter/bin:/flutter/bin/cache/dart-sdk/bin:${PATH}"
RUN flutter config --no-analytics --enable-web && flutter precache --web

WORKDIR /construccion
COPY packages/diseno_flutter packages/diseno_flutter
COPY --from=tokens /construccion/packages/tokens/generado/tokens.dart packages/diseno_flutter/lib/tokens/tokens.dart
COPY clientes/dart clientes/dart
COPY apps/movil apps/movil
RUN dart format packages/diseno_flutter/lib/tokens/tokens.dart >/dev/null

# Los `*.g.dart` de json_serializable NO los produce el generador de OpenAPI: salen de
# build_runner, con el mismo guion que usa la maquina de desarrollo. Sin este paso la
# compilacion muere con «Method not found: '_$UsuarioEncontradoFromJson'».
RUN bash apps/movil/scripts/generar-clientes.sh

WORKDIR /construccion/apps/movil
# `--enforce-lockfile`: se compila con las versiones del pubspec.lock versionado, no con
# las que resuelva el día del build.
RUN flutter pub get --enforce-lockfile
# La app habla con el gateway por el MISMO origen que la sirve, y nginx reenvía /api.
# Va absoluta y con su host en HOSTS_PERMITIDOS: en release `validarGateway`
# (lib/dominio/configuracion.dart) rechaza una ruta relativa, y con `API=/api/v1` la app
# quedaba en «AportaYa no puede arrancar». Por omisión, el origen de TEST.
ARG ORIGEN=https://app.aportaya.161.97.85.216.sslip.io
ARG HOSTS_PERMITIDOS=app.aportaya.161.97.85.216.sslip.io
RUN flutter build web --release \
      --dart-define=API=${ORIGEN}/api/v1 \
      --dart-define=HOSTS_PERMITIDOS=${HOSTS_PERMITIDOS}

# ---------------------------------------------------------------- ejecucion ---
FROM nginxinc/nginx-unprivileged:1.27-alpine AS ejecucion
# La limpieza diaria de Coolify borra toda imagen sin contenedor que no lleve esta
# etiqueta, y esta imagen la construye el host, no Coolify: sin ella el despliegue
# siguiente falla con «No such image» (ver despliegue/TEST.md).
LABEL coolify.managed=true
COPY apps/movil/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=construccion /construccion/apps/movil/build/web /usr/share/nginx/html
COPY apps/movil/docker/assetlinks.json /usr/share/nginx/html/assetlinks.json
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8080/ > /dev/null || exit 1
