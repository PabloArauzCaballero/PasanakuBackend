# Backoffice — Angular compilado a estático y servido por NGINX, sin root.
#   docker build -f apps/backoffice/docker/Dockerfile.backoffice .   (contexto: la raíz del monorepo)
FROM node:22-alpine AS construccion
WORKDIR /construccion
COPY package.json yarn.lock .yarnrc.yml tsconfig.base.json turbo.json ./
COPY apps/backoffice/package.json apps/backoffice/
COPY apps/web/package.json apps/web/
COPY apps/movil/package.json apps/movil/
COPY packages/tokens packages/tokens
COPY packages/ui packages/ui
COPY packages/simulado/package.json packages/simulado/
COPY clientes/angular clientes/angular
RUN corepack enable && yarn install --immutable
COPY apps/backoffice apps/backoffice
RUN yarn workspace @aportaya/tokens build && yarn workspace @aportaya/backoffice build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS ejecucion
COPY apps/backoffice/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=construccion /construccion/apps/backoffice/dist/backoffice/browser /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8080/ > /dev/null || exit 1
