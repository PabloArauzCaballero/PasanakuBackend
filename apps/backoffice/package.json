{
  "name": "@aportaya/backoffice",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "ng lint && python3 ../../scripts/verificar_frontend.py backoffice",
    "test:front": "ng test --include='src/**/*.spec.ts' --exclude='src/**/*.a11y.spec.ts'",
    "test:a11y": "ng test --include='src/**/*.a11y.spec.ts'",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@aportaya/dominio-cliente": "workspace:*",
    "@aportaya/tokens": "workspace:*",
    "@aportaya/tutoriales": "workspace:*",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@aportaya/simulado": "workspace:*",
    "@playwright/test": "^1.65.0",
    "angular-eslint": "^22.6.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-boundaries": "^7.4.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  }
}
