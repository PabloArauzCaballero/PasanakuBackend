{
  "name": "@aportaya/web",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "node scripts/contenido.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "ng lint && python3 ../../scripts/verificar_frontend.py web",
    "test:front": "ng test --include='src/**/*.spec.ts' --exclude='src/**/*.a11y.spec.ts'",
    "test:a11y": "ng test --include='src/**/*.a11y.spec.ts'",
    "test:e2e": "playwright test",
    "serve:ssr:web": "node dist/web/server/server.mjs",
    "contenido": "node scripts/contenido.mjs",
    "capturas": "playwright test pruebas/e2e/catalogo.spec.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "@aportaya/dominio-cliente": "workspace:*",
    "@aportaya/tokens": "workspace:*",
    "@aportaya/tutoriales": "workspace:*",
    "@aportaya/ui": "workspace:*",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@aportaya/simulado": "workspace:*",
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.3",
    "angular-eslint": "^22.5.0",
    "axe-core": "^4.10.0",
    "eslint": "^10.11.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^30.1.1",
    "marked": "^18.0.14",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "vitest-axe": "^0.1.0",
    "yaml": "^2.9.1"
  }
}
