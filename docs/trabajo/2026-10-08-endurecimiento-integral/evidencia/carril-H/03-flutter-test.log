                '///\r\n'
                '/// Devuelve `null` si el puente no está levantado o si macOS todavía no concedió el\r\n'
                '/// permiso de cámara: quien llama ya tiene su camino alternativo.\r\n'
                'Future<List<int>?> pedirFotoAlPuente(String url, {Dio? cliente}) async {\r\n'
                '  try {\r\n'
                '    final r = await (cliente ?? Dio()).get<List<int>>(\r\n'
                '      url,\r\n'
                '      options: Options(\r\n'
                '        responseType: ResponseType.bytes,\r\n'
                '        // La captura arranca la cámara y descarta los primeros cuadros: tarda.\r\n'
                '        receiveTimeout: const Duration(seconds: 25),\r\n'
                '      ),\r\n'
                '    );\r\n'
                '    final bytes = r.data;\r\n'
                '    return (bytes == null || bytes.isEmpty) ? null : bytes;\r\n'
                '  } on Object {\r\n'
                '    return null;\r\n'
                '  }\r\n'
                '}\r\n'
