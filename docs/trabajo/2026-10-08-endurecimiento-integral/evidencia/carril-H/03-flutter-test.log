              'C:\\Users\\Usuario\\Downloads\\Entrypoint-GitHUb\\Pasanaku\\PasanakuBackend-cierre/apps/movil/lib\\dominio\\refrescador.dart': 'import \'package:dio/dio.dart\';\r\n'
                '\r\n'
                'import \'../proveedores/sesion.dart\';\r\n'
                '\r\n'
                '/// Un solo refresco en vuelo por vez: N peticiones que reciben `401` a la vez\r\n'
                '/// comparten el mismo `Future` en vez de disparar un `POST /sesion/refrescar` cada\r\n'
                '/// una. Sale por un `Dio` propio, sin los interceptores de la app: si pasara por\r\n'
                '/// `_TrazaYSesion`, un `401` del propio refresco reentraría a este mismo mecanismo.\r\n'
                'class Refrescador {\r\n'
                '  Refrescador(this._sesion, this._dioSinInterceptores);\r\n'
                '  final Sesion _sesion;\r\n'
                '  final Dio _dioSinInterceptores;\r\n'
                '  Future<bool>? _enVuelo;\r\n'
                '\r\n'
                '  Future<bool> refrescar() => _enVuelo ??= _hacerRefresco().whenComplete(() {\r\n'
                '    _enVuelo = null;\r\n'
                '  });\r\n'
                '\r\n'
                '  Future<bool> _hacerRefresco() async {\r\n'
                '    final refresco = await _sesion.tokenDeRefresco();\r\n'
                '    if (refresco == null) return false;\r\n'
                '    try {\r\n'
                '      final r = await _dioSinInterceptores.post<Map<String, dynamic>>(\r\n'
                '        \'/sesion/refrescar\',\r\n'
                '        data: {\'refresco\': refresco},\r\n'
                '      );\r\n'
                '      final acceso = r.data?[\'acceso\'] as String?;\r\n'
                '      final nuevo = r.data?[\'refresco\'] as String?;\r\n'
                '      if (acceso == null || nuevo == null) return false;\r\n'
                '      await _sesion.guardar(acceso: acceso, refresco: nuevo);\r\n'
                '      return true;\r\n'
                '    } on DioException {\r\n'
                '      return false;\r\n'
                '    }\r\n'
                '  }\r\n'
                '}\r\n'
                '',
