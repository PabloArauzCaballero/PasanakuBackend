@startuml 15_inversiones_clases
' ============================================================
'  MODULO 15: Inversiones voluntarias (DPF y fondo abierto de un aliado)
'  Diagrama de CLASES  (modelo detallado)
'  Servicio dueno: `inversiones` (ver evidencia/carril-D/ADR-inversiones.md).
'  Es inversion VOLUNTARIA del titular con un aliado externo. Con dinero
'  de grupos esta DESACTIVADA (PLAN 4.3): un saldo afectado a un pozo no se invierte.
'  Todo parametro comercial o fiscal de este modulo es SINTETICO mientras
'  no tenga fuente aprobada, y un registro sintetico no es apto para produccion.
' ============================================================
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam DefaultFontName "Helvetica"
skinparam DefaultFontSize 12
skinparam packageStyle rectangle
left to right direction
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 55
hide empty members
skinparam class {
  BackgroundColor #F4F6F7
  BorderColor #34495E
  ArrowColor #2C3E50
  HeaderBackgroundColor #1F5673
  FontColor #1B2631
}

title Modulo 15 - Inversiones voluntarias (clases)

legend top right
  <b>Cadena de una inversion</b>
  Producto --> VersionCondiciones (cotizacion con fecha y fuente)
   --> Consentimiento (version aceptada) --> Orden (saldo retenido)
   --> Posicion (DPF o cuotas) --> Devengo / Valoracion
   --> Rescate --> Comprobante (principal, interes, impuesto, comision)
  Nada de esto promete rentabilidad: el rendimiento de un fondo
  puede ser negativo y el de un DPF es el que fija su contrato.
endlegend

package "Producto y condiciones" {
  class ProductoInversion <<AR>> {
    - id: UUID
    - codigo: String
    - tipo: String <<DPF | FONDO>>
    - emisor: String
    - nivelRiesgo: String <<BAJO | MEDIO | ALTO>>
    --
    + publicarCondiciones(version)
  }
  class VersionCondiciones {
    - numero: Integer
    - fechaCotizacion: DateTime
    - fuente: String
    - origenDatos: String <<SINTETICO | VERIFICADO>>
    - aptoProduccion: Boolean
  }
}

package "Orden y posicion" {
  class OrdenInversion <<AR>> {
    - id: UUID
    - monto: Decimal
    - moneda: String
    - estado: String <<CREADA | RETENIDA | ENVIADA | INCIERTA | CONFIRMADA | RECHAZADA | CANCELADA>>
    --
    + confirmar(posicionExterna)
  }
  class PosicionInversion <<AR>> {
    - id: UUID
    - tipo: String <<DPF | FONDO>>
    - principal: Decimal
    - cuotas: Decimal
    - marcaMaxima: Decimal
    - estado: String <<ABIERTA | CERRADA>>
  }
  class RescateInversion <<AR>> {
    - tipo: String <<PARCIAL | TOTAL | VENCIMIENTO | ANTICIPADO>>
    - estado: String <<SOLICITADO | PENDIENTE | INCIERTO | POR_ACREDITAR | LIQUIDADO | RECHAZADO>>
  }
}

ProductoInversion "1" --> "*" VersionCondiciones
OrdenInversion "1" --> "0..1" PosicionInversion
PosicionInversion "1" --> "*" RescateInversion

note right of PosicionInversion
  El saldo de una posicion se deriva de los comprobantes
  (append-only), no se guarda: costo base creado por la
  suscripcion menos costo base liberado por cada liquidacion.
end note

@enduml

@startuml 15_inversiones_relacional
' ============================================================
'  MODULO 15: Inversiones voluntarias
'  Modelo RELACIONAL (entidad-relacion, listo para DDL)
' ============================================================
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam DefaultFontName "Helvetica"
skinparam DefaultFontSize 12
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 55
hide circle
skinparam class {
  BackgroundColor #EAF2F8
  BorderColor #2874A6
  HeaderBackgroundColor #1F5673
  FontColor #1B2631
}

title Modulo 15 - Inversiones voluntarias (modelo relacional)

legend top right
  <b>Notacion</b>
  * PK    # FK    <<UQ>> unico    <<IDX>> indexado
  <<CK>> CHECK    <<NULL>> admite nulos
  usuario_id, cuenta_billetera_id y los ids de retencion o
  transaccion del libro son UUID OPACOS: este modulo no tiene
  claves foraneas a otro esquema (invariante 11).
endlegend

entity "producto_inversion" as prodinv {
  * id : UUID <<PK>>
  --
  codigo : VARCHAR(40) <<UQ>>
  tipo : VARCHAR(5) <<CK: DPF | FONDO, IDX>>
  nombre : VARCHAR(120)
  emisor : VARCHAR(120)
  moneda : CHAR(3)
  nivel_riesgo : VARCHAR(10) <<CK: BAJO | MEDIO | ALTO>>
  estado : VARCHAR(12) <<CK: ACTIVO | SUSPENDIDO, IDX>>
  creado_en : TIMESTAMPTZ
}

entity "version_condiciones" as vercond {
  * id : UUID <<PK>>
  --
  # producto_inversion_id : UUID <<FK, IDX>>
  numero : SMALLINT <<UQ+producto_inversion_id>>
  plazo_dias : INTEGER <<NULL, CK: > 0>>
  base_dias : SMALLINT <<NULL, CK: > 0>>
  tasa_nominal_anual : DECIMAL(9,6) <<NULL, CK: >= 0>>
  permite_rescate_anticipado : BOOLEAN
  penalizacion_anticipo : DECIMAL(7,6) <<NULL, CK: >= 0>>
  dias_rescate : SMALLINT <<NULL, CK: >= 0>>
  hora_corte : VARCHAR(5) <<NULL>>
  monto_minimo : DECIMAL(14,2) <<CK: > 0>>
  tasa_retencion : DECIMAL(7,6) <<NULL, CK: >= 0>>
  tasa_comision_exito : DECIMAL(7,6) <<NULL, CK: >= 0>>
  costos_texto : VARCHAR(300)
  texto_condiciones : VARCHAR(2000)
  texto_hash : CHAR(64)
  fuente : VARCHAR(200)
  fecha_cotizacion : TIMESTAMPTZ
  origen_datos : VARCHAR(12) <<CK: SINTETICO | VERIFICADO>>
  apto_produccion : BOOLEAN
  vigente_desde : TIMESTAMPTZ
}

entity "consentimiento_inversion" as consinv {
  * id : UUID <<PK>>
  --
  usuario_id : UUID <<IDX>>
  # version_condiciones_id : UUID <<FK, IDX>>
  texto_hash : CHAR(64)
  clave_idempotencia : VARCHAR(80) <<UQ+usuario_id>>
  hash_solicitud : CHAR(64)
  aceptado_en : TIMESTAMPTZ
}

entity "orden_inversion" as ordinv {
  * id : UUID <<PK>>
  --
  usuario_id : UUID <<IDX>>
  # producto_inversion_id : UUID <<FK, IDX>>
  # version_condiciones_id : UUID <<FK, IDX>>
  # consentimiento_inversion_id : UUID <<FK, UQ>>
  cuenta_billetera_id : UUID
  monto : DECIMAL(14,2) <<CK: > 0>>
  moneda : CHAR(3)
  estado : VARCHAR(12) <<CK: CREADA | RETENIDA | ENVIADA | INCIERTA | CONFIRMADA | RECHAZADA | CANCELADA, IDX>>
  clave_idempotencia : VARCHAR(80) <<UQ+usuario_id>>
  hash_solicitud : CHAR(64)
  transaccion_externa : VARCHAR(80) <<NULL>>
  fecha_valor : DATE <<NULL>>
  motivo_rechazo : VARCHAR(60) <<NULL>>
  version : INTEGER
  creada_en : TIMESTAMPTZ
  actualizada_en : TIMESTAMPTZ
}

entity "instruccion_libro" as inslib {
  * id : UUID <<PK>>
  --
  origen_tipo : VARCHAR(10) <<CK: ORDEN | RESCATE, IDX>>
  origen_id : UUID <<IDX, polimorfica>>
  tipo : VARCHAR(10) <<CK: RETENER | LIBERAR | DEBITAR | ACREDITAR>>
  usuario_id : UUID
  cuenta_billetera_id : UUID
  monto : DECIMAL(14,2) <<CK: > 0>>
  moneda : CHAR(3)
  clave_idempotencia : VARCHAR(100) <<UQ>>
  estado : VARCHAR(10) <<CK: PENDIENTE | APLICADA | FALLIDA, IDX>>
  referencia_libro : UUID <<NULL>>
  intentos : INTEGER
  ultimo_error : VARCHAR(60) <<NULL>>
  creada_en : TIMESTAMPTZ
  aplicada_en : TIMESTAMPTZ <<NULL>>
}

entity "posicion_inversion" as posinv {
  * id : UUID <<PK>>
  --
  usuario_id : UUID <<IDX>>
  # producto_inversion_id : UUID <<FK, IDX>>
  # version_condiciones_id : UUID <<FK, IDX>>
  # orden_inversion_id : UUID <<FK, UQ>>
  tipo : VARCHAR(5) <<CK: DPF | FONDO>>
  principal : DECIMAL(14,2) <<CK: > 0>>
  moneda : CHAR(3)
  cuotas : DECIMAL(18,6) <<NULL, CK: >= 0>>
  valor_cuota_entrada : DECIMAL(18,6) <<NULL>>
  marca_maxima : DECIMAL(18,6) <<NULL>>
  fecha_constitucion : DATE
  fecha_vencimiento : DATE <<NULL>>
  posicion_externa : VARCHAR(80) <<UQ>>
  estado : VARCHAR(10) <<CK: ABIERTA | CERRADA, IDX>>
  version : INTEGER
  creada_en : TIMESTAMPTZ
  cerrada_en : TIMESTAMPTZ <<NULL>>
}

entity "devengo_dpf" as devdpf {
  * id : UUID <<PK>>
  --
  # posicion_inversion_id : UUID <<FK, IDX>>
  fecha : DATE <<UQ+posicion_inversion_id>>
  dias_acumulados : INTEGER <<CK: >= 0>>
  interes_acumulado : DECIMAL(14,2) <<CK: >= 0>>
  monto : DECIMAL(14,2) <<CK: >= 0>>
  moneda : CHAR(3)
  creado_en : TIMESTAMPTZ
}

entity "valor_cuota" as valcuo {
  * id : UUID <<PK>>
  --
  # producto_inversion_id : UUID <<FK, IDX>>
  fecha : DATE <<UQ+producto_inversion_id>>
  valor : DECIMAL(18,6) <<CK: > 0>>
  moneda : CHAR(3)
  fuente : VARCHAR(200)
  origen_datos : VARCHAR(12) <<CK: SINTETICO | VERIFICADO>>
  publicado_en : TIMESTAMPTZ
  recibido_en : TIMESTAMPTZ
}

entity "rescate_inversion" as rescinv {
  * id : UUID <<PK>>
  --
  # posicion_inversion_id : UUID <<FK, IDX>>
  usuario_id : UUID <<IDX>>
  tipo : VARCHAR(12) <<CK: PARCIAL | TOTAL | VENCIMIENTO | ANTICIPADO>>
  cuotas : DECIMAL(18,6) <<NULL, CK: > 0>>
  estado : VARCHAR(14) <<CK: SOLICITADO | PENDIENTE | INCIERTO | POR_ACREDITAR | LIQUIDADO | RECHAZADO, IDX>>
  clave_idempotencia : VARCHAR(80) <<UQ+usuario_id>>
  hash_solicitud : CHAR(64)
  fecha_valor : DATE <<NULL>>
  liquida_en : TIMESTAMPTZ <<NULL>>
  transaccion_externa : VARCHAR(80) <<NULL>>
  motivo_rechazo : VARCHAR(60) <<NULL>>
  version : INTEGER
  solicitada_en : TIMESTAMPTZ
  actualizada_en : TIMESTAMPTZ
}

entity "comprobante_inversion" as compinv {
  * id : UUID <<PK>>
  --
  # posicion_inversion_id : UUID <<FK, IDX>>
  usuario_id : UUID <<IDX>>
  tipo : VARCHAR(12) <<CK: SUSCRIPCION | LIQUIDACION>>
  origen_id : UUID <<UQ, polimorfica>>
  sentido_titular : VARCHAR(8) <<CK: DEBITO | CREDITO>>
  principal : DECIMAL(14,2) <<CK: >= 0>>
  interes : DECIMAL(14,2) <<CK: >= 0>>
  impuesto : DECIMAL(14,2) <<CK: >= 0>>
  comision : DECIMAL(14,2) <<CK: >= 0>>
  perdida_realizada : DECIMAL(14,2) <<CK: >= 0>>
  neto : DECIMAL(14,2) <<CK: >= 0>>
  costo_base : DECIMAL(14,2) <<CK: >= 0>>
  moneda : CHAR(3)
  origen_datos : VARCHAR(12) <<CK: SINTETICO | VERIFICADO>>
  emitido_en : TIMESTAMPTZ
}

entity "comision_exito" as comexi {
  * id : UUID <<PK>>
  --
  # posicion_inversion_id : UUID <<FK, IDX>>
  # rescate_inversion_id : UUID <<FK, UQ>>
  cuotas : DECIMAL(18,6) <<CK: > 0>>
  valor_cuota : DECIMAL(18,6) <<CK: > 0>>
  marca_maxima_previa : DECIMAL(18,6) <<CK: > 0>>
  tasa : DECIMAL(7,6) <<CK: >= 0>>
  base_elegible : DECIMAL(14,2) <<CK: >= 0>>
  comision : DECIMAL(14,2) <<CK: >= 0>>
  cuota_neta : DECIMAL(18,6) <<CK: > 0>>
  marca_maxima_nueva : DECIMAL(18,6) <<CK: > 0>>
  moneda : CHAR(3)
  origen_datos : VARCHAR(12) <<CK: SINTETICO | VERIFICADO>>
  calculada_en : TIMESTAMPTZ
}

entity "conciliacion_interes" as concint {
  * id : UUID <<PK>>
  --
  # posicion_inversion_id : UUID <<FK, IDX>>
  # rescate_inversion_id : UUID <<FK, UQ>>
  periodo_desde : DATE
  periodo_hasta : DATE
  interes_devengado : DECIMAL(14,2) <<CK: >= 0>>
  interes_externo : DECIMAL(14,2) <<CK: >= 0>>
  retencion_calculada : DECIMAL(14,2) <<CK: >= 0>>
  retencion_externa : DECIMAL(14,2) <<CK: >= 0>>
  moneda : CHAR(3)
  estado : VARCHAR(12) <<CK: CONCILIADA | DISCREPANCIA, IDX>>
  conciliada_en : TIMESTAMPTZ
}

prodinv ||--|{ vercond : "publica"
vercond ||--o{ consinv : "se acepta en"
consinv ||--o| ordinv : "respalda"
ordinv ||--o| posinv : "origina"
posinv ||--o{ devdpf : "devenga"
posinv ||--o{ rescinv : "se rescata con"
prodinv ||--o{ valcuo : "se valora con"
posinv ||--o{ compinv : "se documenta con"
rescinv ||--o| comexi : "cristaliza"
rescinv ||--o| concint : "concilia"

note top of vercond
  Cada cotizacion es una fila nueva: el texto que la persona
  acepta queda inmutable (append-only) y la orden apunta a la
  version exacta. origen_datos SINTETICO implica
  apto_produccion = FALSE (R-INV-01).
end note

note bottom of compinv
  Principal, interes, impuesto y comision son columnas separadas
  y neto = principal + interes - impuesto - comision (R-INV-03).
  costo_base = principal + perdida_realizada: es lo que permite
  derivar el saldo de una posicion sin guardarlo.
end note

@enduml
