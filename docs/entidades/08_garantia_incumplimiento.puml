@startuml 08_garantia_incumplimiento_clases
' ============================================================
'  MODULO 8: Garantia, Incumplimiento, Cobranza y Sanciones (Parche A)
'  Diagrama de CLASES  (modelo detallado)
'  Cubre: RF-21, RN-21 y todo el ciclo de vida del incumplimiento
'
'  Tesis del modulo: la reputacion NO alcanza. Un puntaje resume,
'  pero no permite cobrar, ni sancionar con debido proceso, ni
'  probar nada ante un reclamo. Por eso el incumplimiento se
'  modela como un EXPEDIENTE propio (RegistroIncumplimiento) con
'  evidencia, gestion de cobranza, deuda exigible, garantia que
'  la cubre, aval que responde, sancion apelable y cierre trazable.
'  La reputacion (M6) es apenas UNA de las consecuencias.
' ============================================================
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam DefaultFontName "Helvetica"
skinparam DefaultFontSize 12
skinparam packageStyle rectangle
left to right direction
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 55
hide empty members
skinparam class {
  BackgroundColor #F4F6F7
  BorderColor #34495E
  ArrowColor #2C3E50
  HeaderBackgroundColor #1F5673
  FontColor #1B2631
}
skinparam package {
  BackgroundColor #FBFCFC
  BorderColor #85929E
  FontColor #1F5673
}

title Modulo 8 - Garantia, Incumplimiento, Cobranza y Sanciones (clases)

legend top right
  <b>Cadena completa de un incumplimiento</b>
  Deteccion -> RegistroIncumplimiento (expediente)
   -> GestionCobranza (escalonada, con promesas de pago)
   -> Cobertura desde el FondoGarantia (el grupo no se detiene)
   -> DeudaParticipante exigible + subrogacion a favor del fondo
   -> Recuperacion / Ejecucion de aval / Castigo
   -> Sancion con derecho a apelacion
   -> Efectos en reputacion (M6) y restricciones (M1)
endlegend

' ============================================================
package "Fondo de Garantia" {

  enum AmbitoFondo {
    POR_GRUPO
    MUTUAL_PLATAFORMA
  }

  enum TipoMovimientoFondo {
    CONSTITUCION
    APORTE_PERIODICO
    COBERTURA_APLICADA
    RECUPERACION_ACREDITADA
    EJECUCION_AVAL
    DEVOLUCION_A_PARTICIPANTES
    CASTIGO_INCOBRABLE
    AJUSTE_CONTABLE
    RENDIMIENTO
  }

  class FondoGarantia <<AR>> {
    - id: UUID
    - ambito: AmbitoFondo
    - grupoId: UUID <<null si es mutual>>
    - moneda: String
    - saldoDisponible: Decimal
    - saldoComprometido: Decimal
    - totalAportado: Decimal
    - totalCubierto: Decimal
    - totalRecuperado: Decimal
    - totalCastigado: Decimal
    - cuentaContableId: UUID
    - estado: String <<ACTIVO | AGOTADO | EN_LIQUIDACION | CERRADO>>
    - version: Integer
    --
    + evaluarDisponibilidad(monto): ResultadoEvaluacion
    + comprometer(monto): Boolean
    + debitar(monto, referencia)
    + acreditar(monto, referencia)
    + indiceSuficiencia(): Decimal
    + proyectarAgotamiento(): Date
    + liquidarYDevolver(): List<DevolucionFondo>
  }

  class PoliticaCobertura <<Pol>> {
    - id: UUID
    - grupoId: UUID <<null = politica global>>
    - porcentajeConstitucion: Decimal <<% de cada aporte que alimenta el fondo>>
    - diasMoraParaActivar: Integer
    - porcentajeMaximoCoberturaPorAporte: Decimal
    - topeCoberturaPorParticipante: Decimal
    - topeCoberturaPorPeriodo: Decimal
    - maxCoberturasPorParticipante: Integer
    - exigeAvalPrevio: Boolean
    - requiereAprobacionManualDesde: Decimal
    - plazoRecuperacionDias: Integer
    - tasaRecargoRecuperacion: Decimal
    - vigenteDesde: DateTime
    --
    + esCubrible(registro): ResultadoEvaluacion
    + montoCubrible(obligacion): Decimal
  }

  class MovimientoFondo {
    - id: UUID
    - fondoId: UUID
    - tipo: TipoMovimientoFondo
    - monto: Decimal
    - saldoResultante: Decimal
    - referenciaTipo: String
    - referenciaId: UUID
    - asientoContableId: UUID
    - descripcion: String
    - fecha: DateTime
    - registradoPor: UUID
    --
    + revertir(motivo): MovimientoFondo
  }

  class DevolucionFondo {
    - id: UUID
    - fondoId: UUID
    - participanteId: UUID
    - montoAportado: Decimal
    - montoConsumido: Decimal
    - montoADevolver: Decimal
    - estado: String <<CALCULADA | PAGADA | RETENIDA>>
    - motivoRetencion: String
    - fecha: DateTime
    --
    + calcularProrrateo(): Decimal
  }
}

' ============================================================
package "Expediente de Incumplimiento" {

  enum TipoIncumplimiento {
    APORTE_ATRASADO
    APORTE_PARCIAL
    APORTE_IMPAGO
    PAGO_RECHAZADO_O_REVERSADO
    COMPROBANTE_FALSO
    ABANDONO_DE_GRUPO
    BENEFICIARIO_NO_CONTINUA_APORTANDO
    INCUMPLIMIENTO_PLAN_REGULARIZACION
    INCUMPLIMIENTO_AVAL
    INCUMPLIMIENTO_ORGANIZADOR
    USO_INDEBIDO_DE_LA_PLATAFORMA
    FRAUDE_CONFIRMADO
  }

  enum SeveridadIncumplimiento {
    LEVE
    MODERADA
    GRAVE
    CRITICA
  }

  enum EstadoIncumplimiento {
    DETECTADO
    NOTIFICADO
    EN_GESTION_COBRANZA
    CON_PROMESA_DE_PAGO
    CUBIERTO_POR_GARANTIA
    EN_RECUPERACION
    SUBSANADO
    REGULARIZADO_CON_PLAN
    CASTIGADO_INCOBRABLE
    JUDICIALIZADO
    ANULADO_POR_ERROR
    PRESCRITO
  }

  enum OrigenDeteccion {
    AUTOMATICO_VENCIMIENTO
    AUTOMATICO_CONCILIACION
    REPORTE_DE_PARTICIPANTE
    REPORTE_DE_ORGANIZADOR
    AUDITORIA_INTERNA
    ALERTA_DE_RIESGO
  }

  class RegistroIncumplimiento <<AR>> {
    - id: UUID
    - codigoExpediente: String <<unico y legible: INC-2026-000123>>
    - usuarioId: UUID
    - participanteId: UUID
    - grupoId: UUID
    - periodoId: UUID
    - cupoId: UUID
    - obligacionId: UUID <<null en incumplimientos no dinerarios>>
    - tipo: TipoIncumplimiento
    - severidad: SeveridadIncumplimiento
    - estado: EstadoIncumplimiento
    - origenDeteccion: OrigenDeteccion
    - montoInvolucrado: Decimal
    - montoRecuperado: Decimal
    - montoCastigado: Decimal
    - diasMoraAlDetectar: Integer
    - diasMoraActuales: Integer
    - esReincidencia: Boolean
    - numeroReincidencia: Integer
    - afectoAlaEntrega: Boolean
    - entregaAfectadaId: UUID
    - detectadoEn: DateTime
    - notificadoEn: DateTime
    - fechaLimiteSubsanacion: DateTime
    - cerradoEn: DateTime
    - motivoCierre: String
    - resumenResolucion: String
    - reportadoPor: UUID
    - responsableGestion: UUID
    - version: Integer
    --
    + clasificarSeveridad(politica): SeveridadIncumplimiento
    + notificarInvolucrados()
    + abrirGestionCobranza(): GestionCobranza
    + solicitarCobertura(): CoberturaIncumplimiento
    + registrarSubsanacion(pagoId)
    + escalar(nuevaSeveridad, motivo)
    + anularPorError(motivo, adminId)
    + prescribir()
    + cerrar(motivo)
    + saldoPendiente(): Decimal
    + lineaDeTiempo(): List<HistorialEstadoIncumplimiento>
  }

  class EvidenciaIncumplimiento {
    - id: UUID
    - registroId: UUID
    - tipo: String <<CAPTURA_ESTADO | EXTRACTO | COMUNICACION | ACTA_ACUERDO | LOG_SISTEMA | DOCUMENTO>>
    - descripcion: String
    - urlArchivo: String
    - hashArchivo: String
    - contenidoEstructurado: JSON
    - aportadaPor: UUID
    - fechaHora: DateTime
    - esInmutable: Boolean
    --
    + sellar(): String
    + verificarIntegridad(): Boolean
  }

  class HistorialEstadoIncumplimiento {
    - id: UUID
    - registroId: UUID
    - estadoAnterior: EstadoIncumplimiento
    - estadoNuevo: EstadoIncumplimiento
    - motivo: String
    - montoAsociado: Decimal
    - ejecutadoPor: UUID
    - esAutomatico: Boolean
    - fechaHora: DateTime
  }

  class DescargoParticipante {
    - id: UUID
    - registroId: UUID
    - participanteId: UUID
    - argumento: String
    - evidencias: List<String>
    - estado: String <<PRESENTADO | EN_ANALISIS | ACEPTADO | RECHAZADO>>
    - resolucion: String
    - resueltoPor: UUID
    - presentadoEn: DateTime
    - resueltoEn: DateTime
    --
    + presentar()
    + resolver(decision, nota)
  }

  class HistorialIncumplimientoUsuario {
    - usuarioId: UUID
    - totalIncumplimientos: Integer
    - incumplimientosLeves: Integer
    - incumplimientosGraves: Integer
    - incumplimientosAbiertos: Integer
    - montoTotalIncumplido: Decimal
    - montoTotalRecuperado: Decimal
    - montoCastigadoHistorico: Decimal
    - gruposAbandonados: Integer
    - ultimoIncumplimientoEn: DateTime
    - diasMoraPromedio: Decimal
    - tasaRegularizacion: Decimal
    - estaEnListaRestriccion: Boolean
    - actualizadoEn: DateTime
    --
    + recalcular()
    + esAptoParaNuevoGrupo(): Boolean
    + exportarReporte(): Documento
  }

  class ListaRestriccionInterna {
    - id: UUID
    - usuarioId: UUID
    - motivo: String
    - registroOrigenId: UUID
    - nivelRestriccion: String <<OBSERVACION | LIMITADO | VETADO>>
    - montoAdeudado: Decimal
    - incluidoEn: DateTime
    - vigenteHasta: DateTime
    - retiradoEn: DateTime
    - retiradoPor: UUID
    - motivoRetiro: String
    --
    + incluir(motivo)
    + retirar(adminId, motivo)
    + bloqueaAccion(accion): Boolean
  }

  class DetectorIncumplimiento <<Svc>> {
    --
    + barrerVencimientos(fecha): List<RegistroIncumplimiento>
    + detectarPagosReversados(): List<RegistroIncumplimiento>
    + detectarAbandonos(): List<RegistroIncumplimiento>
    + recalcularDiasMora(): Integer
    + evaluarPrescripcion(): Integer
  }

  class ScoreRiesgoIncumplimiento {
    - id: UUID
    - usuarioId: UUID
    - grupoId: UUID
    - probabilidadIncumplimiento: Decimal
    - factoresPrincipales: JSON
    - nivelRiesgo: String <<BAJO | MEDIO | ALTO | MUY_ALTO>>
    - accionSugerida: String
    - calculadoEn: DateTime
    --
    + recalcular()
    + generarAlertaTemprana(): AlertaTemprana
  }

  class AlertaTemprana {
    - id: UUID
    - usuarioId: UUID
    - grupoId: UUID
    - codigo: String <<PAGA_CADA_VEZ_MAS_TARDE | NO_ABRE_MENSAJES | MULTIPLES_GRUPOS_EN_MORA>>
    - descripcion: String
    - severidad: String
    - estado: String <<ABIERTA | ATENDIDA | DESCARTADA>>
    - generadaEn: DateTime
    --
    + accionPreventiva(): String
  }
}

' ============================================================
package "Gestion de Cobranza" {

  enum EtapaCobranza {
    PREVENTIVA
    TEMPRANA
    ADMINISTRATIVA
    PREJUDICIAL
    JUDICIAL
    CASTIGO
  }

  enum ResultadoContacto {
    SIN_RESPUESTA
    CONTACTADO_SE_COMPROMETE
    CONTACTADO_SE_NIEGA
    TELEFONO_ERRONEO
    PAGO_INMEDIATO
    SOLICITA_PLAN
    DISPUTA_LA_DEUDA
  }

  class GestionCobranza <<AR>> {
    - id: UUID
    - registroId: UUID
    - etapaActual: EtapaCobranza
    - gestorAsignadoId: UUID
    - montoEnGestion: Decimal
    - intentosContacto: Integer
    - ultimoContactoEn: DateTime
    - proximaAccionEn: DateTime
    - estado: String <<ACTIVA | PAUSADA | CERRADA_EXITOSA | CERRADA_SIN_EXITO>>
    - abiertaEn: DateTime
    - cerradaEn: DateTime
    --
    + ejecutarSiguienteAccion(): AccionCobranza
    + escalarEtapa()
    + asignarGestor(usuarioId)
    + registrarPromesa(fecha, monto): PromesaPago
    + cerrar(resultado)
    + costoAcumulado(): Decimal
  }

  class EstrategiaCobranza <<Pol>> {
    - id: UUID
    - etapa: EtapaCobranza
    - diasMoraDesde: Integer
    - diasMoraHasta: Integer
    - canalesPermitidos: List<String>
    - frecuenciaDias: Integer
    - maxContactosPorSemana: Integer
    - plantillaNotificacionCodigo: String
    - requiereGestorHumano: Boolean
    - permiteQuita: Boolean
    - quitaMaximaPorcentaje: Decimal
    - siguienteEtapa: EtapaCobranza
    --
    + aplicaA(diasMora): Boolean
    + siguienteAccion(gestion): AccionCobranza
  }

  class AccionCobranza {
    - id: UUID
    - gestionId: UUID
    - etapa: EtapaCobranza
    - tipo: String <<RECORDATORIO_AUTOMATICO | LLAMADA | MENSAJE_DIRECTO | VISITA | CARTA_FORMAL | AVISO_A_AVALISTA | ULTIMATUM>>
    - canal: String
    - notificacionId: UUID <<modulo 5>>
    - resultado: ResultadoContacto
    - notaGestor: String
    - costo: Decimal
    - ejecutadaPor: UUID
    - ejecutadaEn: DateTime
    --
    + registrarResultado(resultado, nota)
  }

  class PromesaPago {
    - id: UUID
    - gestionId: UUID
    - montoPrometido: Decimal
    - fechaPrometida: Date
    - canalCompromiso: String
    - estado: String <<VIGENTE | CUMPLIDA | INCUMPLIDA | PARCIAL>>
    - montoEfectivo: Decimal
    - registradaPor: UUID
    - creadaEn: DateTime
    - evaluadaEn: DateTime
    --
    + evaluarCumplimiento()
    + incumplir()
  }

  class AcuerdoQuita {
    - id: UUID
    - registroId: UUID
    - montoOriginal: Decimal
    - montoCondonado: Decimal
    - montoAPagar: Decimal
    - justificacion: String
    - aprobadoPor: UUID
    - acuerdoGrupoId: UUID <<votacion del grupo, M2>>
    - estado: String <<PROPUESTO | APROBADO | EJECUTADO | RECHAZADO>>
    - fecha: DateTime
    --
    + aprobar(aprobadorId)
    + ejecutar()
  }
}

' ============================================================
package "Cobertura, Deuda y Recuperacion" {

  enum EstadoCobertura {
    SOLICITADA
    APROBADA
    APLICADA
    RECHAZADA
    EN_RECUPERACION
    RECUPERADA_TOTAL
    RECUPERADA_PARCIAL
    INCOBRABLE
    REVERSADA
  }

  enum EstadoDeuda {
    VIGENTE
    EN_MORA
    EN_PLAN_DE_PAGO
    PAGADA
    CONDONADA
    CASTIGADA
    JUDICIALIZADA
  }

  class CoberturaIncumplimiento <<AR>> {
    - id: UUID
    - fondoId: UUID
    - registroId: UUID
    - obligacionId: UUID
    - periodoId: UUID
    - montoSolicitado: Decimal
    - montoCubierto: Decimal
    - porcentajeCobertura: Decimal
    - estado: EstadoCobertura
    - requirioAprobacionManual: Boolean
    - aprobadaPor: UUID
    - motivoRechazo: String
    - movimientoFondoId: UUID
    - asientoContableId: UUID
    - solicitadaEn: DateTime
    - aplicadaEn: DateTime
    --
    + evaluarElegibilidad(politica): ResultadoEvaluacion
    + aprobar(aprobadorId)
    + aplicar()
    + rechazar(motivo)
    + reversar(motivo)
    + generarDeuda(): DeudaParticipante
  }

  class DeudaParticipante <<AR>> {
    - id: UUID
    - usuarioId: UUID
    - participanteId: UUID
    - grupoId: UUID
    - registroId: UUID
    - coberturaId: UUID <<null si no hubo cobertura>>
    - acreedor: String <<FONDO_GARANTIA | GRUPO | PLATAFORMA>>
    - capitalOriginal: Decimal
    - recargosAcumulados: Decimal
    - totalAbonado: Decimal
    - saldoActual: Decimal
    - moneda: String
    - estado: EstadoDeuda
    - esSubrogada: Boolean
    - fechaExigibilidad: Date
    - fechaPrescripcion: Date
    - diasVencida: Integer
    - version: Integer
    --
    + acumularRecargo(politica)
    + abonar(monto, origen): AbonoRecuperacion
    + condonar(monto, acuerdoId)
    + castigar(motivo): CastigoDeuda
    + estaSaldada(): Boolean
    + antiguedadDias(): Integer
  }

  class AbonoRecuperacion {
    - id: UUID
    - deudaId: UUID
    - monto: Decimal
    - origen: String <<PAGO_VOLUNTARIO | DESCUENTO_DE_ENTREGA | EJECUCION_AVAL | ACUERDO_QUITA | COMPENSACION>>
    - pagoId: UUID <<modulo 3>>
    - entregaId: UUID <<modulo 4, si se descuento del cobro>>
    - aplicadoACapital: Decimal
    - aplicadoARecargos: Decimal
    - saldoResultante: Decimal
    - movimientoFondoId: UUID
    - fecha: DateTime
    - registradoPor: UUID
    --
    + aplicar()
    + revertir(motivo)
  }

  class CastigoDeuda {
    - id: UUID
    - deudaId: UUID
    - montoCastigado: Decimal
    - motivo: String <<INCOBRABLE | PRESCRIPCION | COSTO_MAYOR_QUE_DEUDA | FALLECIMIENTO | RESOLUCION_LEGAL>>
    - justificacion: String
    - aprobadoPor: UUID
    - asientoContableId: UUID
    - mantieneRegistroReputacional: Boolean
    - fecha: DateTime
    --
    + ejecutar()
    + reactivarSiPaga(monto)
  }

  class Subrogacion {
    - id: UUID
    - coberturaId: UUID
    - deudaId: UUID
    - acreedorOriginal: String
    - acreedorSubrogado: String
    - montoSubrogado: Decimal
    - fecha: DateTime
    - documentoRespaldoUrl: String
    --
    + formalizar()
  }
}

