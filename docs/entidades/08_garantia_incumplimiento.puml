  }

  class EjecucionAval {
    - id: UUID
    - avalId: UUID
    - registroId: UUID
    - deudaId: UUID
    - montoEjecutado: Decimal
    - estado: String <<NOTIFICADA | ACEPTADA | PAGADA | RECHAZADA | EN_DISPUTA>>
    - notificadaEn: DateTime
    - plazoRespuesta: DateTime
    - pagoId: UUID
    - generaDeudaDelAvalista: Boolean
    --
    + notificar()
    + registrarPago(pagoId)
    + escalarPorNoPago()
  }
}

' ============================================================
package "Sanciones con Debido Proceso" {

  enum TipoSancion {
    ADVERTENCIA
    RECARGO_MONETARIO
    AFECTACION_REPUTACION
    PERDIDA_DE_PRIORIDAD_DE_TURNO
    SUSPENSION_DE_VOTO
    RETENCION_DE_ENTREGA
    RESTRICCION_NUEVOS_GRUPOS
    EXPULSION_DEL_GRUPO
    INHABILITACION_PLATAFORMA
  }

  class PoliticaSancion <<Pol>> {
    - id: UUID
    - grupoId: UUID <<null = global>>
    - version: String
    - requiereAcuerdoGrupo: Boolean
    - plazoDescargoDias: Integer
    - plazoApelacionDias: Integer
    - prescribeEnDias: Integer
    - vigenteDesde: DateTime
    --
    + sancionesPara(tipo, severidad, reincidencia): List<MatrizSancion>
  }

  class MatrizSancion {
    - id: UUID
    - politicaId: UUID
    - tipoIncumplimiento: TipoIncumplimiento
    - severidad: SeveridadIncumplimiento
    - numeroReincidencia: Integer
    - tipoSancion: TipoSancion
    - valor: Decimal
    - duracionDias: Integer
    - esAutomatica: Boolean
    - requiereRevisionHumana: Boolean
    --
    + instanciar(registro): Sancion
  }

  class Sancion {
    - id: UUID
    - registroId: UUID
    - usuarioId: UUID
    - participanteId: UUID
    - matrizId: UUID
    - tipo: TipoSancion
    - descripcion: String
    - montoRecargo: Decimal
    - impactoReputacion: Decimal
    - vigenteDesde: DateTime
    - vigenteHasta: DateTime
    - estado: String <<PROPUESTA | NOTIFICADA | EN_DESCARGO | FIRME | EN_APELACION | REVOCADA | CUMPLIDA | PRESCRITA>>
    - aplicadaPor: UUID
    - acuerdoGrupoId: UUID
    - notificadaEn: DateTime
    - firmeEn: DateTime
    --
    + notificar()
    + quedarFirme()
    + ejecutar()
    + revocar(motivo, resolutorId)
    + apelar(argumento): ApelacionSancion
    + estaVigente(): Boolean
  }

  class ApelacionSancion {
    - id: UUID
    - sancionId: UUID
    - apelanteId: UUID
    - argumento: String
    - evidencias: List<String>
    - estado: String <<PRESENTADA | ADMITIDA | EN_REVISION | ACEPTADA | RECHAZADA | DESISTIDA>>
    - instancia: String <<ORGANIZADOR | COMITE_GRUPO | SOPORTE_PLATAFORMA>>
    - resueltaPor: UUID
    - resolucion: String
    - presentadaEn: DateTime
    - fechaLimiteResolucion: DateTime
    - resueltaEn: DateTime
    --
    + admitir()
    + resolver(decision, fundamento)
    + escalarInstancia()
  }
}

