    - puntajeReputacion: Decimal
    - aceptaCondiciones: Boolean
    - fuenteCandidato: String <<LISTA_ESPERA | INVITACION | EMPAREJAMIENTO>>
    - estado: String <<PROPUESTO | ACEPTADO | DESCARTADO>>
