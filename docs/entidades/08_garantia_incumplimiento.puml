    + evaluar(): Decimal
  }

  class PlanContingencia {
    - id: UUID
    - grupoId: UUID
    - disparador: String <<MORA_CRITICA | FONDO_AGOTADO | ABANDONO_MASIVO | ORGANIZADOR_INHABILITADO>>
    - tipo: String <<PRORRATEO_ENTRE_ACTIVOS | REDUCCION_DE_BOLSA | EXTENSION_DE_PLAZO | REEMPLAZO | DISOLUCION>>
    - descripcion: String
    - impactoEstimado: Decimal
    - requiereAcuerdo: Boolean
    - acuerdoGrupoId: UUID
    - estado: String <<PROPUESTO | APROBADO | EJECUTADO | DESCARTADO>>
    - propuestoEn: DateTime
    - ejecutadoEn: DateTime
    --
    + simularImpacto(): JSON
    + ejecutar()
  }

  class DisolucionAnticipada {
    - id: UUID
    - grupoId: UUID
    - motivo: String
    - acuerdoGrupoId: UUID
    - totalAportadoGrupo: Decimal
    - totalEntregado: Decimal
    - saldoADistribuir: Decimal
    - estado: String <<INICIADA | CALCULADA | EJECUTADA | CERRADA>>
    - iniciadaEn: DateTime
    - cerradaEn: DateTime
    --
    + calcularPosicionNeta(): List<LiquidacionParticipante>
    + ejecutar()
  }

  class LiquidacionParticipante {
    - id: UUID
    - disolucionId: UUID
    - participanteId: UUID
    - totalAportado: Decimal
    - totalCobrado: Decimal
    - deudaPendiente: Decimal
    - posicionNeta: Decimal <<positiva = se le devuelve; negativa = debe>>
    - estado: String <<CALCULADA | PAGADA | EN_COBRANZA>>
    --
    + liquidar()
  }
}

' ---------- Relaciones ----------
FondoGarantia "1" *-- "0..*" MovimientoFondo
FondoGarantia "1" *-- "0..*" CoberturaIncumplimiento
FondoGarantia "1" *-- "0..*" DevolucionFondo
FondoGarantia "*" --> "1" PoliticaCobertura : se rige por >

RegistroIncumplimiento "1" *-- "0..*" EvidenciaIncumplimiento
RegistroIncumplimiento "1" *-- "1..*" HistorialEstadoIncumplimiento
RegistroIncumplimiento "1" *-- "0..*" DescargoParticipante
RegistroIncumplimiento "1" *-- "0..1" GestionCobranza
RegistroIncumplimiento "1" *-- "0..1" CoberturaIncumplimiento
RegistroIncumplimiento "1" *-- "0..1" DeudaParticipante
RegistroIncumplimiento "1" *-- "0..*" Sancion
RegistroIncumplimiento "1" *-- "0..1" AcuerdoQuita
RegistroIncumplimiento "1" *-- "0..1" ReemplazoParticipante
RegistroIncumplimiento "0..*" --> "1" HistorialIncumplimientoUsuario : alimenta >
RegistroIncumplimiento ..> ListaRestriccionInterna : puede originar >
DetectorIncumplimiento ..> RegistroIncumplimiento : crea >
ScoreRiesgoIncumplimiento ..> AlertaTemprana : genera >

GestionCobranza "1" *-- "0..*" AccionCobranza
GestionCobranza "1" *-- "0..*" PromesaPago
GestionCobranza "*" --> "1" EstrategiaCobranza : sigue >

CoberturaIncumplimiento "1" *-- "0..1" Subrogacion
CoberturaIncumplimiento ..> DeudaParticipante : origina >
DeudaParticipante "1" *-- "0..*" AbonoRecuperacion
DeudaParticipante "1" *-- "0..1" CastigoDeuda
DeudaParticipante "1" -- "0..1" Subrogacion

AvalParticipante "1" *-- "0..*" EjecucionAval
EjecucionAval ..> DeudaParticipante : abona / traslada >

PoliticaSancion "1" *-- "1..*" MatrizSancion
MatrizSancion "1" ..> "0..*" Sancion : instancia >
Sancion "1" *-- "0..*" ApelacionSancion

ReemplazoParticipante "1" *-- "0..*" CandidatoReemplazo
PlanContingencia ..> ReemplazoParticipante : puede incluir >
PlanContingencia ..> DisolucionAnticipada : puede derivar en >
DisolucionAnticipada "1" *-- "1..*" LiquidacionParticipante

FondoGarantia --> AmbitoFondo
MovimientoFondo --> TipoMovimientoFondo
RegistroIncumplimiento --> TipoIncumplimiento
RegistroIncumplimiento --> SeveridadIncumplimiento
RegistroIncumplimiento --> EstadoIncumplimiento
RegistroIncumplimiento --> OrigenDeteccion
GestionCobranza --> EtapaCobranza
AccionCobranza --> ResultadoContacto
CoberturaIncumplimiento --> EstadoCobertura
DeudaParticipante --> EstadoDeuda
Sancion --> TipoSancion

note right of RegistroIncumplimiento
  <b>Por que un expediente y no un flag</b>
  Un booleano "moroso" no responde: cuanto debe,
  desde cuando, que se hizo para cobrarle, quien
  autorizo la cobertura, que dijo el en su
  descargo, que sancion se le aplico y si la
  apelo. El expediente responde todo eso y es la
  prueba ante un reclamo o una auditoria (M9).
  La reputacion (M6) se alimenta de aqui, no al reves.
end note

note right of HistorialIncumplimientoUsuario
  <b>Portabilidad del mal historial</b>
  Proyeccion agregada por usuario y CROSS-GRUPO:
  quien abandono un pasanaku no puede entrar
  limpio al siguiente. Se consulta al evaluar
  SolicitudIngreso (M2) y en el emparejamiento
  automatico (RF-19).
end note

note bottom of MatrizSancion
  <b>Proporcionalidad y debido proceso</b>
  La sancion no la decide una persona de humor
  variable: sale de la matriz
  (tipo x severidad x reincidencia). El afectado
  tiene plazo de descargo antes de que quede
  firme y derecho a apelacion en dos instancias.
  Sin esto, expulsar a alguien es arbitrario.
end note

note bottom of AvalParticipante
  Formaliza la practica real del pasanaku: quien
  te invita responde por ti. avalistaUsuarioId
  puede ser el invitadoPorId del participante
  (M2). La ejecucion del aval abona la deuda del
  avalado y, si el avalista tampoco paga, se le
  abre su propio RegistroIncumplimiento
  (tipo = INCUMPLIMIENTO_AVAL).
end note

note bottom of CastigoDeuda
  Castigar (dar de baja contablemente) NO borra
  el registro reputacional:
  mantieneRegistroReputacional = true. Si el
  deudor aparece anos despues, la deuda se
  reactiva. El castigo es una decision contable,
  no un perdon.
end note

@enduml

