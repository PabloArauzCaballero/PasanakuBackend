package "Aval Solidario" {

  class AvalParticipante {
    - id: UUID
    - grupoId: UUID
    - participanteAvaladoId: UUID
    - avalistaUsuarioId: UUID
    - esParticipanteDelGrupo: Boolean
    - montoMaximoAvalado: Decimal
    - alcance: String <<TOTAL | UN_PERIODO | PORCENTAJE>>
    - porcentajeResponsabilidad: Decimal
    - aceptadoEn: DateTime
    - tokenAceptacionId: UUID
    - estado: String <<PENDIENTE | VIGENTE | EJECUTADO | LIBERADO | RECHAZADO>>
